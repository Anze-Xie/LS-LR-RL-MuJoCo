<mujoco model="go2 scene">
  <compiler angle="radian" eulerseq="XYZ" />
  <option gravity="0 0 -9.8" timestep="0.001"/>
  <include file="go2.xml"/>

  <visual>
      <global azimuth="45" elevation="-20"/>
      <quality shadowsize="4096"/>
      <headlight ambient="0.45 0.45 0.50" diffuse="0.65 0.65 0.70" specular="0.25 0.25 0.25"/>
      <map znear="0.01" zfar="50"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.35 0.48 0.65" rgb2="0.85 0.90 0.96" width="512" height="512"/>
    <mesh name="slope_mesh" file="斜坡.STL" scale="0.001 0.001 0.001"/>
    <mesh name="stairs_mesh" file="楼梯.STL" scale="0.001 0.001 0.001"/>
    <mesh name="Plum_blossom_stakes_mesh" file="梅花桩.STL" scale="0.001 0.001 0.001"/>
    <texture name="background_texture" type="2d" file="background.png"/>
    <material name="metal_material" rgba="0.08 0.08 0.09 1.0" specular="0.9" shininess="0.9"/>
    <material name="frosted_white_glass" rgba="0.96 0.96 0.98 0.6" specular="0.4" shininess="0.25"/>
    <material name="background_material" texture="background_texture" rgba="1 1 1 1" specular="0.2" shininess="0.5"/>

  </asset>

  <worldbody>
    <camera name="isekai_view" pos="3 10.1 1.6" xyaxes="0 -1 0 0 0 1"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- ==================== 环境光 ==================== -->
    <light directional="true" pos="0 10.1 5" dir="0 0 -1" diffuse="0.75 0.80 0.90" specular="0.30 0.30 0.35" castshadow="true"/>
    <light mode="fixed" pos="0.0 4.0 1.6" diffuse="0.65 0.72 0.85" specular="0.20 0.20 0.25" attenuation="0.8 0.1 0.01"/>
    <light mode="fixed" pos="0.0 8.0 1.6" diffuse="0.65 0.72 0.85" specular="0.20 0.20 0.25" attenuation="0.8 0.1 0.01"/>
    <light mode="fixed" pos="0.0 12.0 1.6" diffuse="0.65 0.72 0.85" specular="0.20 0.20 0.25" attenuation="0.8 0.1 0.01"/>
    <light mode="fixed" pos="0.0 16.0 1.6" diffuse="0.65 0.72 0.85" specular="0.20 0.20 0.25" attenuation="0.8 0.1 0.01"/>
    <!-- ==================== 通道 ==================== -->
    <geom name="floor_corridor" type="box" size="1.1 10.1 0.05" pos="0 10.1 0.05" material="metal_material"/>
    <geom name="wall_ceiling" type="box" size="1.1 10.1 0.05" pos="0 10.1 3.15" material="metal_material"/>
    <geom name="background_wall" type="box" size="0.05 10.1 1.5" pos="-1.05 10.1 1.6" material="background_material"/>
    <geom name="glass_wall" type="box" size="0.05 10.1 1.5" pos="1.05 10.1 1.6" rgba="0 0 0 0.1"/>
    <geom name="wall_entry" type="box" size="1 0.05 1.5" pos="0 0.05 1.6" material="metal_material"/>
    <geom name="wall_exit" type="box" size="1 0.05 1.5" pos="0 20.15 1.6" material="metal_material"/>
    <!-- ==================== 斜坡 ==================== -->
    <geom name="slope" type="mesh" mesh="slope_mesh" pos="-1 2.6 0.1" material="frosted_white_glass"/>
    <!-- ==================== 台阶 ==================== -->
    <geom name="stairs" type="mesh" mesh="stairs_mesh" pos="-1 7.1 0.1" material="frosted_white_glass"/>
    <!-- ==================== 梅花桩 ==================== -->
    <geom name="Plum_blossom_stakes1" type="mesh" mesh="Plum_blossom_stakes_mesh" pos="-0.3 13 0.1" material="frosted_white_glass"/>
    <geom name="Plum_blossom_stakes2" type="mesh" mesh="Plum_blossom_stakes_mesh" pos="-0.3 14 0.1" material="frosted_white_glass"/>
    <geom name="Plum_blossom_stakes3" type="mesh" mesh="Plum_blossom_stakes_mesh" pos="-0.3 15 0.1" material="frosted_white_glass"/>
    <geom name="Plum_blossom_stakes4" type="mesh" mesh="Plum_blossom_stakes_mesh" pos="-0.3 16 0.1" material="frosted_white_glass"/>
    <geom name="Plum_blossom_stakes5" type="mesh" mesh="Plum_blossom_stakes_mesh" pos="-0.3 17 0.1" material="frosted_white_glass"/>
  </worldbody>
</mujoco>
